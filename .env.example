# Copy to `.env` (npm run setup:keys does this for you). `.env` is git-ignored: never commit it and
# never paste its contents into a chat. Offline mode needs none of this.

# ---------------------------------------------------------------------------------------------
# Wardy Agent
# ---------------------------------------------------------------------------------------------
# offline = no keys, no funds, recorded fixtures. testnet / live = real services.
WARDY_MODE=offline
# ed25519 key that signs verdicts. Offline mode uses a fixed test key and labels it as such.
WARDY_SIGNING_KEY=
# Live mode refuses to start above 10 NEAR equivalent unless this is 1.
WARDY_I_UNDERSTAND_RISK=
# Lets a worker agent ask to pay. It isn't a spend grant, and it can't approve anything.
WARDY_AGENT_TOKEN=
# Lets the owner freeze, unfreeze and see what's waiting. Never give this to an agent.
WARDY_OWNER_TOKEN=
# Whose fleet this instance spends for. Defaults to AGENT_OWNER_ACCOUNT_ID, or a demo name offline.
WARDY_OWNER_ID=
# Where the API listens. Keep it on 127.0.0.1 unless you've put real protection in front of it.
WARDY_API_HOST=127.0.0.1
WARDY_API_PORT=8787
# Where approval links point: the dashboard's phone page.
WARDY_WEB_URL=http://localhost:5173
# Optional. The dashboard's port, and where verdicts are kept (.data/<mode> by default).
# WARDY_WEB_PORT=5173
# WARDY_DATA_DIR=.data/offline
# Optional, for the MCP server and demo agent. Which API they call, and the name shown for an MCP worker.
# WARDY_API_URL=http://127.0.0.1:8787
# WARDY_WORKER_NAME=mcp-agent

# ---------------------------------------------------------------------------------------------
# Custody: NEAR Intents Agent API ("Agent Connect"). MAINNET WITH REAL FUNDS, both URLs below.
# Key starts with naa_ and is shown once. Portal: https://partners.near-intents.org/
# Keep the URL and the key from the same environment.
#   Production: https://api.agentsonintents.com
#   Demo (temporary keys, rotate after the demo period): https://api.demo.agentsonintents.com
# ---------------------------------------------------------------------------------------------
NEAR_INTENTS_AGENT_API_URL=https://api.agentsonintents.com
NEAR_INTENTS_AGENT_API_KEY=
# Dedicated owner account holding little value. `npm run setup:keys` generates these.
# Used only by owner scripts (create agent, sign policy, issue grant, provider freeze).
AGENT_OWNER_ACCOUNT_ID=
AGENT_OWNER_PRIVATE_KEY=
# Filled in by the Phase 1 custody script.
WARDY_AGENT_ID=
WARDY_GRANT_TOKEN=
# Test merchant under our control for the real ALLOW payment. `npm run setup:keys` generates these.
DEMO_MERCHANT_ACCOUNT_ID=
DEMO_MERCHANT_PRIVATE_KEY=

# ---------------------------------------------------------------------------------------------
# Custody fallback: OutLayer. Key starts with wk_. Testnet works without Intents routes.
#   Mainnet: https://api.outlayer.ai   Testnet: https://testnet-api.outlayer.ai
# ---------------------------------------------------------------------------------------------
OUTLAYER_API_URL=https://testnet-api.outlayer.ai
OUTLAYER_API_KEY=

# ---------------------------------------------------------------------------------------------
# Private AI: NEAR AI Cloud. Key from https://cloud.near.ai
# Live model list: GET https://cloud-api.near.ai/v1/model/list (use attestationSupported models)
# ---------------------------------------------------------------------------------------------
NEAR_AI_CLOUD_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_CLOUD_API_KEY=
NEAR_AI_MODEL=z-ai/glm-5.3-flash

# ---------------------------------------------------------------------------------------------
# Chain data
# ---------------------------------------------------------------------------------------------
NEAR_RPC_URL=https://free.rpc.fastnear.com
NEAR_TESTNET_RPC_URL=https://test.rpc.fastnear.com
NEARBLOCKS_API_URL=https://api.nearblocks.io
# Optional. The free tier is about 6 calls a minute, so results are cached.
NEARBLOCKS_API_KEY=

# ---------------------------------------------------------------------------------------------
# Wardy Network registry on NEAR testnet: nothing to set here. `npm run hello:contract` keeps its free
# testnet keys in .data/testnet-accounts.json; the public address is in config/registry.testnet.json.
# ---------------------------------------------------------------------------------------------

# ---------------------------------------------------------------------------------------------
# Hosted server only (`npm run serve`, Fly.io). Set with `fly secrets set`, never in this file.
# It refuses to start with WARDY_SIGNING_KEY or any mainnet setting: it makes its own key and pays
# testnet only, from OUTLAYER_API_KEY's wallet. All optional; the defaults are shown.
# ---------------------------------------------------------------------------------------------
# WARDY_PUBLIC_URL=https://wardy-agent.fly.dev
# WARDY_HOSTED_SIGNING_KEY=
# WARDY_POOL_DAILY_LIMIT=1
# WARDY_AI_DAILY_LIMIT=500
# Private checks one owner may have read for them a day, inside the server-wide limit above.
# WARDY_AI_OWNER_DAILY_LIMIT=50
# Payment requests one owner's agent may make a day. Each one is a line on the shared disk.
# WARDY_OWNER_DAILY_REQUESTS=1000
# WARDY_MAX_OWNERS=500
# WARDY_PROXY_HOPS=1

# ---------------------------------------------------------------------------------------------
# Optional (Should / Stretch)
# ---------------------------------------------------------------------------------------------
# 1Click, dry quotes need no key: https://1click.chaindefuser.com
ONECLICK_API_URL=https://1click.chaindefuser.com
ONECLICK_JWT=
# Agent Market agent token, starts with aat_
AGENT_MARKET_TOKEN=
# Telegram HOLD approvals
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# PingPay x402 facilitator
PINGPAY_API_KEY=
