{
  "name": "wardy-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Payment firewall and shared scam-payee network for AI agents on NEAR",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "prepare": "node scripts/install-hooks.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/web",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:fixtures": "tsx scripts/check-fixture-names.ts",
    "setup:keys": "tsx scripts/setup-keys.ts",
    "setup:check": "tsx scripts/setup-check.ts",
    "setup:testnet": "tsx scripts/setup-testnet-custody.ts",
    "hello:indexer": "tsx scripts/hello-indexer.ts",
    "hello:ai": "tsx scripts/hello-ai.ts",
    "hello:custody": "tsx scripts/hello-custody.ts",
    "hello:contract": "tsx scripts/hello-contract.ts",
    "contract:test": "cargo test --manifest-path contracts/registry/Cargo.toml",
    "contract:build": "cd contracts/registry && cargo near build non-reproducible-wasm",
    "demo": "tsx scripts/demo.ts",
    "attack-lab": "tsx apps/attack-lab/src/cli.ts",
    "agent": "tsx apps/demo-agent/src/cli.ts",
    "dev": "tsx scripts/dev.ts",
    "build:web": "npm run build -w @wardy-agent/web",
    "test:ui": "tsx scripts/ui-check.ts",
    "verify-audit": "tsx scripts/verify-audit.ts",
    "network:seed": "tsx scripts/seed-network.ts",
    "network:anchor": "tsx scripts/network-anchor.ts",
    "network:verify": "tsx scripts/network-verify.ts",
    "walkthrough": "tsx scripts/walkthrough.ts",
    "mcp:config": "tsx scripts/mcp-config.ts"
  },
  "devDependencies": {
    "@scure/base": "^2.4.0",
    "@types/node": "^24.19.2",
    "axe-core": "^4.14.0",
    "near-api-js": "^7.4.0",
    "puppeteer-core": "^25.16.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
