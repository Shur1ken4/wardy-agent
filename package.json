{
  "name": "wardy-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Payment firewall and shared scam-payee network for AI agents on NEAR",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "prepare": "node scripts/install-hooks.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:secrets": "node scripts/check-secrets.mjs",
    "setup:keys": "tsx scripts/setup-keys.ts",
    "setup:check": "tsx scripts/setup-check.ts",
    "hello:indexer": "tsx scripts/hello-indexer.ts",
    "hello:ai": "tsx scripts/hello-ai.ts",
    "hello:custody": "tsx scripts/hello-custody.ts",
    "hello:contract": "tsx scripts/hello-contract.ts",
    "contract:test": "cargo test --manifest-path contracts/registry/Cargo.toml",
    "contract:build": "cd contracts/registry && cargo near build non-reproducible-wasm",
    "demo": "node scripts/not-built-yet.mjs demo 4",
    "attack-lab": "node scripts/not-built-yet.mjs attack-lab 4",
    "agent": "node scripts/not-built-yet.mjs agent 4",
    "dev": "node scripts/not-built-yet.mjs dev 3",
    "verify-audit": "node scripts/not-built-yet.mjs verify-audit 2",
    "network:seed": "node scripts/not-built-yet.mjs network:seed 5",
    "network:anchor": "node scripts/not-built-yet.mjs network:anchor 5"
  },
  "devDependencies": {
    "@scure/base": "^2.4.0",
    "@types/node": "^24.19.2",
    "near-api-js": "^7.4.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
